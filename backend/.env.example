# 服务
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI 兼容（Key 只写在本地 .env，勿提交）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# 数据
DATABASE_URL=sqlite:///./data/companion.db

# 测试/无 Key 时：允许用本地假流式（仅开发；生产保持 false）
ALLOW_MOCK_LLM=false

# 出站 gated 流式窗口（字符）；越小首包越快，仍先过词库再发出
OUTPUT_FLUSH_CHARS=16
