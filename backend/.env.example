# 服务
# Docker 试用：复制本文件为 .env 并填 LLM_API_KEY 后，在仓库根目录执行 docker compose up --build（见 docs/docker.md）
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI 兼容（Key 只写在本地 .env，勿提交）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# 数据
DATABASE_URL=sqlite:///./data/companion.db

# 测试/无 Key 时：允许用本地假流式（仅开发；生产保持 false）
ALLOW_MOCK_LLM=false

# 出站 gated 流式窗口（字符）；越小首包越快，仍先过词库再发出
OUTPUT_FLUSH_CHARS=16

# 百炼语音（TTS/ASR；与 LLM Key 分开；空则前端回退浏览器 Web Speech）
DASHSCOPE_API_KEY=
# 业务空间示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# ASR OpenAI 兼容：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_MODEL=qwen-audio-3.0-tts-flash
ASR_MODEL=qwen3-asr-flash
TTS_VOICE_NUAN=longanhuan_v3.6
TTS_VOICE_TIAO=longjielidou_v3.6
TTS_VOICE_CHA=longanhuan_v3.6
SPEECH_TIMEOUT_SECONDS=60

# 中文维基百科检索（联网百科；失败静默降级为普通陪伴）
WIKI_ENABLED=true
WIKI_API_BASE=https://zh.wikipedia.org/w/api.php
WIKI_TIMEOUT_SECONDS=3
WIKI_MAX_CHARS=600

# 阿里云 AI 安全护栏入站文本审核（默认关；AccessKey 与 DASHSCOPE_API_KEY 分开）
# 开通：AI 安全护栏 + RAM 策略 AliyunYundunGreenWebFullAccess
MODERATION_ENABLED=false
MODERATION_ACCESS_KEY_ID=
MODERATION_ACCESS_KEY_SECRET=
MODERATION_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com
MODERATION_SERVICE=query_security_check
MODERATION_TIMEOUT_SECONDS=2
# 命中这些 RiskLevel 时温和拒答（high,medium）；超时/错误 fail-open
MODERATION_BLOCK_RISK_LEVELS=high,medium
