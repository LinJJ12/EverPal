# Dependencies / build
node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/
.env
.env.*
!.env.example
# Narrow whitelist: only the frontend build-time file may be committed.
!frontend/.env.production

# OS / IDE
.DS_Store
Thumbs.db
*.log
.idea/
*.swp
*.swo
*~

# Editor local settings (team may keep shared snippets elsewhere)
.vscode/settings.json
.vscode/*.log

# Local secrets / runtime
*.local
.cache/

# Backend runtime (also listed under backend/.gitignore)
backend/data/*.db
backend/data/**/*.db
backend/resource/logs/
backend/resource/cache/
backend/resource/tmp/

# Trellis per-developer workspace journals and AI session records are local-only
.trellis/workspace/

# Third-party reference clones (e.g. kids-ai) — local only, do not push
vendor/*
!vendor/README.md
